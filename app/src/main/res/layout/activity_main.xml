<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center"
    android:background="#0B132B">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="♛ Chess Assistant"
        android:textSize="32sp"
        android:textColor="#4CC9F0"
        android:layout_marginBottom="40dp" />

    <!-- No ImageView -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter Chess.com Username"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/usernameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g., pixelexploits"
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:background="@android:drawable/editbox_background"
        android:padding="12dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/saveUsernameBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Username"
        android:backgroundTint="#4CC9F0"
        android:textColor="#0B132B"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/accessibilityStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="❌ Accessibility: OFF"
        android:textColor="#FF4444"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/enableAccessibilityBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Accessibility Settings"
        android:backgroundTint="#4CC9F0"
        android:textColor="#0B132B"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/toggleFeaturesBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Toggle Features"
        android:backgroundTint="#4CC9F0"
        android:textColor="#0B132B"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/startBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="START OVERLAY"
        android:backgroundTint="#00FF00"
        android:textColor="#0B132B"
        android:textSize="18sp"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📺 Subscribe to Pixel Developer"
        android:textColor="#4CC9F0"
        android:textSize="14sp"
        android:layout_marginTop="30dp"
        android:clickable="true"
        android:onClick="openYouTube" />

</LinearLayout>
